NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ph_loan?schema=public
# Generate each key independently; never use these placeholders on a server.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ENCRYPTION_KEY=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173
# Only matters when NODE_ENV=production. In development the OTP is returned in the API response.
ALLOW_MOCK_SMS=false
KYC_UPLOADS_ENABLED=true
KYC_STORAGE_PERSISTENT=false
UPLOAD_DIR=./uploads
